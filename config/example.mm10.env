# Copy this file, set the reference and software paths, then pass it as argument 2.
genome=mm10
gmac=mm
ARCref=/path/to/refdata-cellranger-arc-mm10
GEXref=/path/to/refdata-gex-mm10
ATACref=/path/to/refdata-cellranger-atac-mm10
fasta=/path/to/bwa/mm10.fa
blacklist=/path/to/mm10.blacklist.bed
OUTPUT_DIR=/path/to/new_analysis_directory

# Commands may be absolute executables or container command prefixes.
sifpath=/path/to/singularity
scom="singularity run $sifpath/cpu0.0.1a-r2.sumner.sif"
dedup="singularity run $sifpath/GATK_latest.sif gatk MarkDuplicates --BARCODE_TAG=ZB --REMOVE_DUPLICATES=true --ADD_PG_TAG_TO_READS=false"
juicertool="singularity run $sifpath/juicer_1.22.01.sif"
arc10x="cellranger-arc count"
gex10x="cellranger count"
atac10x="cellranger-atac reanalyze"
Rcmd=Rscript
python=python3
samcmd=samtools
bedcmd=bedtools
bgzip=bgzip
tabix=tabix
pigz="pigz -f"
bamCoverage=bamCoverage

QUEUE=cpu
smallQUEUE=cpu
highpart=cpu
NTHREAD=48
NTHREAD10x=48
cbNthread=24
GB=200
cbdictGB=400
highGB=320
DOWNSTREAM_GB=320
LINKER_GB=15
MAPPING_GB=40
MERGE_GB=36
TABLE_GB=8
SUMMARY_GB=2

chemistry=ARC-v1
addLinkerSeq="-A ACGTGATATTTCACGACTCT"
mapq=20
minMapScore=30
selfbp=1
bulkSelfbp=8000
minPETsignif=3
shiftsize=-75
peakext=150
macsq=0.001
peak_signal_min=1.5

# QC is applied after RNA/ATAC/PET barcode intersection.
CHAIR_MIN_RNA=100
CHAIR_MIN_ATAC=100
CHAIR_MIN_PET=50
CHAIR_MAX_MT=20
CHAIR_MAX_RIBO=50
CHAIR_DOUBLET_RATE=0.054
CHAIR_SEED=1234
CHAIR_RNA_DIMS=30
CHAIR_ATAC_DIMS=30
CHAIR_RNA_RESOLUTION=0.8
CHAIR_ATAC_RESOLUTION=0.8
CHAIR_WNN_RESOLUTION=0.5
