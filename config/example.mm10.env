# cp config/example.mm10.env config/my_run.env
# Edit my_run.env, then pass it as the second pipeline argument.
genome=mm10
gmac=mm
ARCref=/path/to/refdata-cellranger-arc-mm10
GEXref=/path/to/refdata-gex-mm10
ATACref=/path/to/refdata-cellranger-atac-mm10
fasta=/path/to/bwa/mm10.fa
blacklist=/path/to/mm10.blacklist.bed
OUTPUT_DIR=/path/to/new_analysis_directory

# Container: singularity build scMAV.sif docker://fengchuiguo1994/scmav:v1
image=/path/to/scMAV.sif
# Keep Juicer Tools 1.22.01 beside the image.
juicer_jar="$(dirname -- "$image")/juicer_tools_1.22.01.jar"
# Add the base directories holding data, references and outputs.
export SINGULARITY_BIND=/data
scom="singularity exec $image"
dedup="singularity exec $image gatk MarkDuplicates --BARCODE_TAG=ZB --REMOVE_DUPLICATES=true --ADD_PG_TAG_TO_READS=false"
juicertool="singularity exec --bind ${juicer_jar}:/opt/software/juicer_tools.1.8.9_jcuda.0.8.jar:ro $image juicer_tools"
arc10x="singularity exec $image cellranger-arc count"
gex10x="singularity exec $image cellranger count"
atac10x="singularity exec $image cellranger-atac reanalyze"
Rcmd="conda run --no-capture-output -n chair-r Rscript"
python="singularity exec $image python"
samcmd="singularity exec $image samtools"
bedcmd="singularity exec $image bedtools"
bgzip="singularity exec $image bgzip"
tabix="singularity exec $image tabix"
pigz="singularity exec $image pigz -f"
bamCoverage="singularity exec $image bamCoverage"

QUEUE=cpu
smallQUEUE=cpu
highpart=cpu
NTHREAD=48
NTHREAD10x=48
cbNthread=24
GB=200
cbdictGB=400
highGB=320
DOWNSTREAM_GB=320
LINKER_GB=15
MAPPING_GB=40
MERGE_GB=36
TABLE_GB=8
SUMMARY_GB=2

chemistry=ARC-v1
addLinkerSeq="-A ATAGGCGCTGGTTGCGTTGT"
mapq=20
minMapScore=30
selfbp=1
bulkSelfbp=8000
minPETsignif=3
shiftsize=-75
peakext=150
macsq=0.001
peak_signal_min=1.5

# QC is applied after RNA/ATAC/PET barcode intersection.
CHAIR_MIN_RNA=400
CHAIR_MIN_ATAC=4000
CHAIR_MIN_PET=300
CHAIR_MAX_MT=20
CHAIR_MAX_RIBO=50
CHAIR_DOUBLET_RATE=0.054
CHAIR_SEED=1234
CHAIR_RNA_DIMS=30
CHAIR_ATAC_DIMS=30
CHAIR_RNA_RESOLUTION=0.8
CHAIR_ATAC_RESOLUTION=0.8
CHAIR_WNN_RESOLUTION=0.5
